##########################################################################################
# pdstable/__init__.pyi
##########################################################################################

from collections.abc import Callable, Generator, Iterator
from pathlib import Path
from typing import Any, TypeAlias

import numpy as np
from filecache import FCPath
from pdsparser import Pds3Label

__version__: str

__all__ = ['PdsColumnInfo', 'PdsTable', 'PdsTableInfo']

_Lowercase: TypeAlias = bool | tuple[bool, bool]


class PdsTableInfo:
    def __init__(self, label_file_path: str | Path | FCPath) -> None: ...
    @property
    def label(self) -> Pds3Label | dict[str, Any]: ...
    @property
    def label_file_name(self) -> str: ...
    @property
    def label_file_path(self) -> Path: ...
    @property
    def table_file_name(self) -> str: ...
    @property
    def table_file_path(self) -> Path: ...
    @property
    def header_bytes(self) -> int: ...
    @property
    def fixed_length_row(self) -> bool: ...
    @property
    def field_delimiter(self) -> bytes | None: ...
    @property
    def rows(self) -> int: ...
    @property
    def columns(self) -> int: ...
    @property
    def row_bytes(self) -> int | None: ...
    @property
    def column_info_list(self) -> list[PdsColumnInfo]: ...
    @property
    def column_info_dict(self) -> dict[str, PdsColumnInfo]: ...
    @property
    def dtype0(self) -> dict[str, tuple[str, int]]: ...


class PdsColumnInfo:
    def __init__(self) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def colno(self) -> int: ...
    @property
    def start_byte(self) -> int | None: ...
    @property
    def bytes(self) -> int | None: ...
    @property
    def items(self) -> int | None: ...
    @property
    def item_bytes(self) -> int | None: ...
    @property
    def item_offset(self) -> int | None: ...
    @property
    def data_type(self) -> str: ...
    @property
    def dtype0(self) -> tuple[str, int] | None: ...
    @property
    def dtype1(self) -> dict[str, tuple[str, int]] | None: ...
    @property
    def dtype2(self) -> str: ...
    @property
    def scalar_func(self) -> Callable[[str], Any] | None: ...
    @property
    def valid_range(self) -> tuple[float, float] | list[float] | None: ...
    @property
    def invalid_values(self) -> set[Any]: ...


class PdsTable:
    def __init__(self, label_file: str | Path | FCPath, *,
                 label_contents: (str | list[str] | dict[str, Any] | Pds3Label
                                  | None) = None,
                 times: list[str] | None = None,
                 columns: list[str] | None = None,
                 nostrip: list[str] | None = None,
                 callbacks: dict[str, Callable[..., str | bytes]] | None = None,
                 ascii: bool = False,  # noqa: A002
                 replacements: dict[str, dict[Any, Any]] | None = None,
                 invalid: dict[str, list[Any] | set[Any] | float | str] | None = None,
                 valid_ranges: dict[str, tuple[float, float] | list[float]] | None = None,
                 table_callback: Callable[[list[bytes]], list[bytes]] | None = None,
                 merge_masks: bool = False,
                 filename_keylen: int = 0,
                 row_range: tuple[int, int] | list[int] | None = None,
                 table_file: str | int | None = None,
                 label_method: str = 'strict',
                 fmt_dirs: (str | Path | FCPath | list[str | Path | FCPath]
                            | None) = None,
                 defer_load: bool = False) -> None: ...

    def __iter__(self) -> Iterator[dict[str, Any]]: ...
    def iter_dicts(self, chunk_rows: int = 1000, *,
                   lowercase: _Lowercase = (False, False)
                   ) -> Generator[dict[str, Any]]: ...

    @staticmethod
    def rows_from_label(label_file: str | Path | FCPath, *,
                        label_contents: (str | list[str] | dict[str, Any] | Pds3Label
                                         | None) = None,
                        table_file: str | int | None = None,
                        label_method: str = 'strict',
                        fmt_dirs: (str | Path | FCPath | list[str | Path | FCPath]
                                   | None) = None) -> int: ...

    @property
    def pdslabel(self) -> Pds3Label | dict[str, Any]: ...
    @property
    def label_file_name(self) -> str: ...
    @property
    def label_file_path(self) -> Path: ...
    @property
    def table_file_name(self) -> str: ...
    @property
    def table_file_path(self) -> Path: ...
    @property
    def is_pds4(self) -> bool: ...
    @property
    def rows(self) -> int: ...
    @property
    def first(self) -> int: ...
    @property
    def columns(self) -> int: ...
    @property
    def all_columns(self) -> int: ...
    # A column whose items are not all arrays comes back as a list rather than an array.
    # Returning "numpy.ndarray | Any" lets callers use either form without narrowing.
    @property
    def column_values(self) -> dict[str, np.ndarray | Any]: ...
    @property
    def column_masks(self) -> dict[str, np.ndarray]: ...
    @property
    def column_info_list(self) -> list[PdsColumnInfo]: ...
    @property
    def column_info_dict(self) -> dict[str, PdsColumnInfo]: ...
    @property
    def header_bytes(self) -> int: ...
    @property
    def encoding(self) -> str: ...
    @property
    def fixed_length_row(self) -> bool: ...
    @property
    def field_delimiter(self) -> bytes | None: ...
    @property
    def row_bytes(self) -> int | None: ...
    @property
    def dtype0(self) -> dict[str, tuple[str, int]]: ...
    @property
    def info(self) -> PdsTableInfo: ...
    @property
    def filename_keys(self) -> list[str]: ...

    def dicts_by_row(self, lowercase: _Lowercase = (False, False)
                     ) -> list[dict[str, Any]]: ...
    # See column_values above.
    def get_column(self, name: str) -> np.ndarray | Any: ...
    def get_column_mask(self, name: str) -> np.ndarray: ...
    def get_keys(self) -> list[str]: ...

    def find_row_indices(self, lowercase: _Lowercase = (False, False), *,
                         limit: int | None = None, substrings: list[str] | None = None,
                         **params: Any) -> list[int]: ...
    def find_row_index(self, lowercase: _Lowercase = (False, False), *,
                       substrings: list[str] | None = None, **params: Any) -> int: ...
    def find_rows(self, lowercase: _Lowercase = (False, False),
                  **params: Any) -> list[dict[str, Any]]: ...
    def find_row(self, lowercase: _Lowercase = (False, False),
                 **params: Any) -> dict[str, Any]: ...

    def filename_key(self, filename: str) -> str: ...
    def bundle_column_index(self) -> int: ...
    def volume_column_index(self) -> int: ...
    def filespec_column_index(self) -> int: ...

    def find_row_indices_by_bundle_filespec(self, bundle_name: str,
                                            filespec: str | None = None, *,
                                            limit: int | None = None,
                                            substring: bool = False) -> list[int]: ...
    def find_row_indices_by_volume_filespec(self, volume_id: str,
                                            filespec: str | None = None, *,
                                            limit: int | None = None,
                                            substring: bool = False) -> list[int]: ...
    def find_row_index_by_bundle_filespec(self, bundle_name: str,
                                          filespec: str | None = None, *,
                                          substring: bool = False) -> int: ...
    def find_row_index_by_volume_filespec(self, volume_id: str,
                                          filespec: str | None = None,
                                          substring: bool = False) -> int: ...
    def find_rows_by_bundle_filespec(self, bundle_name: str,
                                     filespec: str | None = None, *,
                                     limit: int | None = None,
                                     substring: bool = False) -> list[dict[str, Any]]: ...
    def find_rows_by_volume_filespec(self, volume_id: str,
                                     filespec: str | None = None, *,
                                     limit: int | None = None,
                                     substring: bool = False) -> list[dict[str, Any]]: ...
    def find_row_by_bundle_filespec(self, bundle_name: str, filespec: str | None = None,
                                    substring: bool = False) -> dict[str, Any]: ...
    def find_row_by_volume_filespec(self, volume_id: str, filespec: str | None = None, *,
                                    substring: bool = False) -> dict[str, Any]: ...

    def index_rows_by_filename_key(self) -> None: ...
    def row_indices_by_filename_key(self, key: str) -> list[int]: ...
    def rows_by_filename_key(self, key: str) -> list[dict[str, Any]]: ...
